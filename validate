# This shell script provides a quick but limited test of CrxFetch's parsing abilities.
for pair in "uBlock:cjpalhdlnbpafiamejdnhcphjbkeiagm" "Translate:aapbdbdomjkkjkaonfhkkikfgjllcleb"; do
    name=${pair%%:*}; eid=${pair##*:}
    x=$(python3 -c "import urllib.parse,sys;print(urllib.parse.quote('id='+sys.argv[1]+'&installsource=ondemand&uc',safe=''))" "$eid")
    echo -e "\n=== $name ($eid) ===\n"
    curl -sS --max-time 30 \
    "https://clients2.google.com/service/update2/crx?response=update_2&prodversion=155.0.8059.26&acceptformat=crx3&prod=chrome&prodchannel=stable&os=win&arch=x86-64&x=$x" \
 |  sed 's/></>\n</g' | grep -E 'app |updatecheck|status=' | head -6
done